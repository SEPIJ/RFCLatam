<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ready Fractional Chief — Dirección comercial fraccional</title>
<meta name="description" content="Dirección comercial fraccional para empresas de ventas consultivas en Colombia y Latam.">

<link rel="icon" type="image/png" sizes="256x256" href="data:image/png;base64,">
<link rel="icon" type="image/png" sizes="192x192" href="data:image/png;base64,">
<link rel="icon" type="image/png" sizes="32x32" href="data:image/png;base64,">
<link rel="icon" type="image/png" sizes="16x16" href="data:image/png;base64,">
<link rel="apple-touch-icon" href="data:image/png;base64,">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Unbounded:wght@500;600;700;800&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

<style>
  :root{
    --blue:#1155CC;
    --blue-deep:#092E70;
    --blue-black:#050B1A;
    --near-black:#0A0F1E;
    --graphite:#5A626A;
    --paper:#EEF0EE;
    --brass:#8E6E28;
    --brass-light:#E8C77A;
    --white:#FFFFFF;
    --ink:#12151A;
    --ink-soft:#2B3038;
    --on-dark:#C7D2ED;
    --max:1160px;
    --radius-m:16px;
    --slant:5.5vw;
    --font-body:'Manrope', system-ui, sans-serif;
    --font-impact:'Unbounded', 'Manrope', system-ui, sans-serif;
    --font-mono:'IBM Plex Mono', ui-monospace, monospace;
    --ease:cubic-bezier(.16,.84,.44,1);
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important;}
  }

  body{
    margin:0; font-family:var(--font-body); color:var(--white);
    background:var(--blue-black); line-height:1.5; -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  img{max-width:100%; display:block;}
  a{color:inherit;}
  h1,h2,h3{margin:0; font-weight:800; letter-spacing:-0.01em;}
  p{margin:0;}
  .wrap{max-width:var(--max); margin:0 auto; padding:0 28px; position:relative; z-index:3;}
  ::selection{background:var(--brass); color:var(--white);}
  a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, summary:focus-visible{
    outline:3px solid var(--brass-light); outline-offset:2px;
  }

  /* ---------- Reveal (symmetric in/out) ---------- */
  .reveal{opacity:0; transform:translateY(36px) scale(.98); transition:opacity .8s var(--ease), transform .8s var(--ease);}
  .reveal.in{opacity:1; transform:translateY(0) scale(1);}
  .stagger > *{opacity:0; transform:translateY(28px); transition:opacity .7s var(--ease), transform .7s var(--ease);}
  .stagger.in > *{opacity:1; transform:translateY(0);}
  .stagger.in > *:nth-child(1){transition-delay:.02s;}
  .stagger.in > *:nth-child(2){transition-delay:.10s;}
  .stagger.in > *:nth-child(3){transition-delay:.18s;}
  .stagger.in > *:nth-child(4){transition-delay:.26s;}
  .stagger.in > *:nth-child(5){transition-delay:.34s;}
  .stagger.in > *:nth-child(6){transition-delay:.42s;}

  /* ---------- Header ---------- */
  header{position:fixed; top:0; left:0; right:0; z-index:1000; transition:background .3s ease, border-color .3s ease;
    border-bottom:1px solid transparent;}
  header.scrolled{background:rgba(5,11,26,.72); backdrop-filter:blur(14px); border-color:rgba(255,255,255,.08);}
  header .wrap{display:flex; align-items:center; justify-content:space-between; height:76px;}
  header .brand img{height:24px;}
  header nav{display:flex; align-items:center; gap:32px;}
  header nav a.nav-link{font-size:14.5px; font-weight:600; text-decoration:none; color:var(--white); opacity:.85;
    transition:opacity .25s ease;}
  header nav a.nav-link:hover{opacity:1;}
  header .cta-btn{font-weight:700; font-size:14px; background:linear-gradient(120deg, var(--brass), var(--brass-light));
    color:var(--ink); border:none; padding:11px 22px; border-radius:999px; cursor:pointer; text-decoration:none;
    transition:transform .25s ease, box-shadow .25s ease;}
  header .cta-btn:hover{transform:translateY(-2px); box-shadow:0 10px 24px rgba(142,110,40,.4);}
  .menu-toggle{display:none; background:none; border:none; cursor:pointer; padding:6px;}
  .menu-toggle span{display:block; width:22px; height:2px; background:var(--white); margin:5px 0;}
  @media (max-width:900px){
    header nav{position:fixed; top:76px; left:0; right:0; bottom:0; background:var(--blue-black);
      flex-direction:column; align-items:flex-start; padding:32px 28px; gap:22px;
      transform:translateX(100%); transition:transform .35s var(--ease);}
    header nav.open{transform:translateX(0);}
    header nav a.nav-link{font-size:18px; opacity:1;}
    .menu-toggle{display:block;}
  }

  /* ==================================================================
     PANEL SYSTEM — every major section is a "panel" with its own
     background layer, so sections read as distinct, sliced blocks
     (same device as the brand deck: alternating diagonal panels)
     ================================================================== */
  .panel{position:relative; overflow:hidden; padding:150px 0 130px;}
  .panel-bg{position:absolute; inset:-1px; z-index:1;}
  .panel.cut{
    clip-path:polygon(0 var(--slant), 100% 0, 100% 100%, 0 100%);
    margin-top:calc(var(--slant) * -1);
  }
  .panel.cut .panel-bg{clip-path:polygon(0 var(--slant), 100% 0, 100% 100%, 0 100%);}
  .panel.blue .panel-bg{background:linear-gradient(135deg, var(--blue-deep) 0%, var(--blue) 100%);}
  .panel.deep .panel-bg{background:linear-gradient(150deg, var(--near-black) 0%, var(--blue-deep) 100%);}
  .panel.light .panel-bg{background:var(--paper);}
  .panel.light{color:var(--ink);}
  .panel.light .on-dark{color:var(--graphite) !important;}

  .blob{position:absolute; border-radius:50%; filter:blur(70px); pointer-events:none; z-index:1; will-change:transform;}

  .section-head{max-width:600px; margin-bottom:52px;}
  .section-head .kicker-label{
    font-family:var(--font-mono); font-size:12.5px; letter-spacing:.08em; color:var(--brass-light);
    display:block; margin-bottom:14px;
  }
  .panel.light .section-head .kicker-label{color:var(--brass);}
  .section-head h2{font-family:var(--font-impact); font-weight:600; font-size:clamp(1.8rem,3.4vw,2.5rem); color:var(--white);}
  .panel.light .section-head h2{color:var(--ink);}
  .section-head p{margin-top:14px; font-size:16.5px; color:var(--on-dark);}
  .panel.light .section-head p{color:var(--graphite);}

  /* ---------- Hero (split cover, like the deck's own cover slide) ---------- */
  .hero{min-height:100vh; display:grid; grid-template-columns:0.86fr 1.14fr; padding-top:76px;}
  .hero-photo{
    background:var(--paper); display:flex; flex-direction:column; justify-content:center;
    padding:60px 48px 60px 56px; position:relative;
  }
  .photo-frame{
    position:relative; border-radius:var(--radius-m); overflow:hidden; max-width:360px;
    box-shadow:0 30px 60px rgba(9,46,112,.22);
    opacity:0; transform:translateY(18px) scale(.97); animation:rise .8s var(--ease) .15s forwards;
  }
  .photo-frame img{width:100%; height:auto; display:block;}
  .arrow-badge{
    position:absolute; top:-18px; right:-18px; width:52px; height:52px; border-radius:50%;
    background:var(--white); box-shadow:0 10px 26px rgba(9,46,112,.25);
    display:flex; align-items:center; justify-content:center;
  }
  .arrow-badge svg{width:20px; height:20px; color:var(--blue);}
  .photo-caption{
    margin-top:26px; max-width:320px;
    opacity:0; transform:translateY(18px); animation:rise .8s var(--ease) .32s forwards;
  }
  .photo-caption .name{font-weight:800; font-size:16px; color:var(--ink);}
  .photo-caption .role{font-size:13.5px; color:var(--graphite); margin-top:2px;}
  .photo-caption .tagline{margin-top:14px; font-size:13.5px; color:var(--blue); font-weight:700;}

  .hero-copy{
    position:relative; background:linear-gradient(150deg, var(--blue-deep) 0%, var(--blue) 100%);
    display:flex; align-items:center; padding:60px 56px 60px 64px; overflow:hidden;
  }
  .hero-copy .blob{width:46vw; height:46vw; right:-16vw; top:-10vw; background:radial-gradient(circle, var(--brass) 0%, transparent 72%); opacity:.22;}
  .hero-inner{max-width:620px; position:relative; z-index:3;}
  .kicker{
    display:inline-flex; align-items:center; gap:8px; font-family:var(--font-mono); font-size:12.5px;
    color:var(--on-dark); border:1px solid rgba(255,255,255,.18); padding:7px 16px; border-radius:999px;
    background:rgba(255,255,255,.05); margin-bottom:28px;
    opacity:0; animation:rise .7s var(--ease) .1s forwards;
  }
  .kicker .dot{width:6px; height:6px; border-radius:50%; background:var(--brass-light); animation:blink 2s ease-in-out infinite;}
  @keyframes blink{0%,100%{opacity:1;} 50%{opacity:.3;}}

  .hero h1{
    font-family:var(--font-impact); font-weight:700; font-size:clamp(2.2rem,4.6vw,3.6rem);
    line-height:1.08; letter-spacing:-0.02em;
    background:linear-gradient(100deg, #ffffff 10%, #BFD3FF 40%, var(--brass-light) 60%, #ffffff 90%);
    background-size:250% 100%;
    -webkit-background-clip:text; background-clip:text; color:transparent;
    animation:sheen 9s linear infinite, rise .8s var(--ease) .22s forwards;
    opacity:0; transform:translateY(20px);
  }
  @keyframes sheen{ to{ background-position:-250% 0; } }
  @keyframes rise{ to{ opacity:1; transform:translateY(0);} }

  .hero .subhead{
    margin-top:26px; max-width:460px; font-size:17px; color:var(--on-dark);
    opacity:0; transform:translateY(20px); animation:rise .8s var(--ease) .4s forwards;
  }
  .hero-ctas{display:flex; flex-wrap:wrap; gap:16px; margin-top:38px;
    opacity:0; transform:translateY(20px); animation:rise .8s var(--ease) .56s forwards;}

  .btn-primary{
    background:linear-gradient(120deg, #ffffff, #DCE6FF); color:var(--blue-deep); font-weight:700; font-size:15px;
    padding:15px 28px; border-radius:999px; text-decoration:none; border:none; cursor:pointer;
    display:inline-flex; align-items:center; gap:10px;
    transition:transform .25s var(--ease), box-shadow .25s var(--ease);
  }
  .btn-primary:hover{transform:translateY(-3px); box-shadow:0 16px 34px rgba(0,0,0,.35);}
  .btn-ghost{
    color:var(--white); font-weight:700; font-size:15px; text-decoration:none;
    padding:14px 24px; border-radius:999px; border:1.5px solid rgba(255,255,255,.35);
    display:inline-flex; align-items:center; gap:10px; transition:.25s var(--ease);
    background:rgba(255,255,255,.04);
  }
  .btn-ghost:hover{border-color:var(--white); background:rgba(255,255,255,.1); transform:translateY(-3px);}

  @media (max-width:960px){
    .hero{grid-template-columns:1fr; min-height:auto;}
    .hero-photo{padding:110px 28px 40px; align-items:center;}
    .photo-frame{max-width:220px;}
    .photo-caption{text-align:center;}
    .hero-copy{padding:56px 28px 70px;}
  }

  /* ---------- NOSOTROS — editorial spine + mission statement ---------- */
  .mission-block{display:grid; grid-template-columns:56px 1fr; gap:36px;}
  .mission-spine{
    writing-mode:vertical-rl; transform:rotate(180deg);
    font-family:var(--font-mono); letter-spacing:.18em; font-size:12px; color:var(--brass-light);
    text-transform:uppercase; display:flex; align-items:center; justify-content:center;
    border-left:1px solid rgba(255,255,255,.18); padding-left:18px;
  }
  .mission-quote{position:relative; padding-top:6px;}
  .mission-quote .mark{
    position:absolute; top:-58px; left:-8px; font-family:var(--font-impact); font-size:120px;
    color:rgba(255,255,255,.08); font-weight:700; line-height:1; pointer-events:none; user-select:none;
  }
  .mission-quote p.big{
    font-family:var(--font-impact); font-weight:600; font-size:clamp(1.5rem,3.2vw,2.3rem);
    line-height:1.42; color:var(--white); max-width:760px; position:relative; z-index:2;
  }
  .mission-quote .vision{margin-top:26px; font-size:15.5px; color:var(--on-dark); max-width:640px;}
  .mission-quote .vision b{color:var(--white); font-weight:700;}

  .vp-list{margin-top:56px; border-top:1px solid rgba(255,255,255,.15);}
  .vp-row{
    display:grid; grid-template-columns:70px 1fr; gap:24px; padding:22px 0;
    border-bottom:1px solid rgba(255,255,255,.15); align-items:baseline;
  }
  .vp-row .n{font-family:var(--font-mono); font-size:13.5px; color:var(--brass-light);}
  .vp-row p{font-size:15.5px; color:var(--white); max-width:640px;}

  @media (max-width:700px){
    .mission-block{grid-template-columns:1fr;}
    .mission-spine{writing-mode:horizontal-tb; transform:none; border-left:none; border-bottom:1px solid rgba(255,255,255,.18);
      padding:0 0 12px; justify-content:flex-start;}
    .mission-quote .mark{display:none;}
    .vp-row{grid-template-columns:40px 1fr;}
  }

  /* ---------- SERVICIOS — editorial index with watermark numerals ---------- */
  .svc-index{border-top:1px solid rgba(255,255,255,.12);}
  .svc-row{
    position:relative; display:grid; grid-template-columns:1fr 1.6fr; gap:40px; align-items:center;
    padding:38px 4px; border-bottom:1px solid rgba(255,255,255,.12); overflow:hidden;
    transition:background .35s ease;
  }
  .svc-row::before{
    content:attr(data-n); position:absolute; right:0; top:50%; transform:translateY(-50%);
    font-family:var(--font-impact); font-weight:700; font-size:clamp(4.5rem,9vw,7.5rem);
    color:rgba(255,255,255,.05); line-height:1; z-index:0; transition:color .35s ease;
  }
  .svc-row:hover{background:rgba(255,255,255,.035);}
  .svc-row:hover::before{color:rgba(232,199,122,.12);}
  .svc-row h3{
    position:relative; z-index:2; font-family:var(--font-impact); font-weight:600; font-size:clamp(1.2rem,2vw,1.55rem);
    color:var(--white); transition:color .3s ease;
  }
  .svc-row:hover h3{color:var(--brass-light);}
  .svc-row p{position:relative; z-index:2; font-size:15px; color:var(--on-dark); max-width:420px;}

  @media (max-width:760px){
    .svc-row{grid-template-columns:1fr;}
    .svc-row::before{font-size:3.5rem; top:14px; transform:none;}
    .svc-row h3{margin-top:44px;}
  }

  /* ---------- CASOS ---------- */
  .cases-banner{
    background:linear-gradient(120deg, rgba(255,255,255,.09), rgba(142,110,40,.14));
    border:1px solid rgba(255,255,255,.14); border-radius:var(--radius-m);
    padding:34px 38px; margin-bottom:34px;
  }
  .cases-banner p{font-size:16px; color:var(--white); line-height:1.6;}
  .cases-banner strong{color:var(--brass-light);}
  .cases-grid{display:grid; grid-template-columns:1fr 1fr; gap:22px;}
  .case-card{
    border:1.5px dashed rgba(255,255,255,.28); border-radius:var(--radius-m); padding:28px;
    display:flex; justify-content:space-between; align-items:flex-start; gap:16px;
  }
  .case-card h3{font-size:16.5px; color:var(--white); margin-bottom:6px; font-family:var(--font-impact); font-weight:600;}
  .case-card p{font-size:13.5px; color:var(--on-dark);}
  .status-pill{flex:none; font-size:11.5px; font-weight:700; color:var(--ink); background:var(--brass-light);
    padding:6px 13px; border-radius:999px;}
  @media (max-width:760px){ .cases-grid{grid-template-columns:1fr;} }

  /* ---------- FAQ (light panel — deliberate contrast breather) ---------- */
  .faq-list{max-width:760px;}
  .faq-item{border-bottom:1px solid #D6D9D6;}
  .faq-item summary{list-style:none; cursor:pointer; padding:24px 4px; font-size:16.5px; font-weight:700;
    color:var(--ink); display:flex; justify-content:space-between; align-items:center; gap:20px;}
  .faq-item summary::-webkit-details-marker{display:none;}
  .faq-item .plus{flex:none; width:24px; height:24px; position:relative;}
  .faq-item .plus::before, .faq-item .plus::after{content:''; position:absolute; background:var(--blue); border-radius:2px;}
  .faq-item .plus::before{width:100%; height:2px; top:50%; left:0; transform:translateY(-50%);}
  .faq-item .plus::after{width:2px; height:100%; left:50%; top:0; transform:translateX(-50%); transition:transform .25s ease;}
  .faq-item[open] .plus::after{transform:translateX(-50%) rotate(90deg);}
  .faq-item .answer{padding:0 4px 24px; color:var(--graphite); font-size:15px; max-width:640px;}

  /* ---------- CONTACTO ---------- */
  .contact-card{
    background:rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.14); border-radius:var(--radius-m);
    padding:44px; display:grid; grid-template-columns:1fr 1.1fr; gap:48px;
  }
  .contact-info{display:flex; flex-direction:column; gap:22px; justify-content:center;}
  .info-row{display:flex; gap:14px; align-items:center;}
  .info-row .ic{flex:none; width:40px; height:40px; border-radius:50%; background:rgba(255,255,255,.09);
    display:flex; align-items:center; justify-content:center;}
  .info-row .ic svg{width:18px; height:18px; color:var(--brass-light);}
  .info-row .label{font-size:12.5px; color:var(--on-dark); margin-bottom:2px;}
  .info-row .val{font-size:15.5px; font-weight:700; color:var(--white); text-decoration:none;}
  .info-row .val:hover{color:var(--brass-light);}

  form{display:flex; flex-direction:column; gap:14px;}
  .form-row{display:grid; grid-template-columns:1fr 1fr; gap:14px;}
  label{font-size:12.5px; font-weight:700; color:var(--on-dark); margin-bottom:5px; display:block;}
  input, textarea{
    width:100%; border:1.5px solid rgba(255,255,255,.2); border-radius:8px; padding:12px 14px;
    font-family:var(--font-body); font-size:14.5px; background:rgba(255,255,255,.06); color:var(--white);
    transition:border-color .2s ease;
  }
  input::placeholder, textarea::placeholder{color:rgba(255,255,255,.4);}
  input:focus, textarea:focus{border-color:var(--brass-light); outline:none;}
  textarea{resize:vertical; min-height:90px;}
  .submit-btn{
    margin-top:4px; background:linear-gradient(120deg, var(--brass), var(--brass-light)); color:var(--ink);
    font-weight:700; font-size:15px; border:none; padding:14px 24px; border-radius:999px; cursor:pointer;
    transition:transform .25s var(--ease);
  }
  .submit-btn:hover{transform:translateY(-2px);}
  .form-note{font-size:12px; color:var(--on-dark); opacity:.85;}

  @media (max-width:840px){
    .contact-card{grid-template-columns:1fr; padding:30px;}
    .form-row{grid-template-columns:1fr;}
  }

  /* ---------- Footer ---------- */
  footer{padding:50px 0 30px; background:var(--blue-black); position:relative; z-index:2;}
  .footer-row{display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px;}
  .footer-row img{height:22px;}
  .footer-links{display:flex; gap:24px; flex-wrap:wrap;}
  .footer-links a{font-size:13.5px; color:var(--on-dark); text-decoration:none;}
  .footer-links a:hover{color:var(--white);}
  .footer-copy{margin-top:26px; font-size:12.5px; color:rgba(255,255,255,.4); text-align:center;}

  /* ---------- WhatsApp float ---------- */
  .wa-float{
    position:fixed; right:22px; bottom:22px; z-index:1200; width:58px; height:58px; border-radius:50%;
    background:#1D9E56; display:flex; align-items:center; justify-content:center; text-decoration:none;
    box-shadow:0 10px 30px rgba(0,0,0,.4); transition:transform .2s ease;
  }
  .wa-float:hover{transform:scale(1.08);}
  .wa-float svg{width:29px; height:29px; fill:var(--white);}
  .wa-float .ring{position:absolute; inset:0; border-radius:50%; border:2px solid #1D9E56; animation:pulse-ring 2.6s ease-out infinite;}
  @keyframes pulse-ring{0%{transform:scale(1); opacity:.7;} 100%{transform:scale(2); opacity:0;}}
  .wa-tooltip{position:absolute; right:70px; top:50%; transform:translateY(-50%); background:var(--white); color:var(--ink);
    font-size:12.5px; font-weight:700; padding:7px 13px; border-radius:8px; white-space:nowrap; opacity:0;
    pointer-events:none; transition:opacity .2s ease;}
  .wa-float:hover .wa-tooltip{opacity:1;}
  @media (max-width:600px){ .wa-float{width:52px; height:52px; right:14px; bottom:14px;} .wa-tooltip{display:none;} }
</style>
</head>
<body>

<header id="site-header">
  <div class="wrap">
    <a href="#inicio" class="brand" aria-label="Ready Fractional Chief — inicio">
      <img src="data:image/png;base64," alt="Ready Fractional Chief">
    </a>
    <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mainNav">
      <span></span><span></span><span></span>
    </button>
    <nav id="mainNav">
      <a class="nav-link" href="#nosotros">Nosotros</a>
      <a class="nav-link" href="#servicios">Servicios</a>
      <a class="nav-link" href="#casos">Casos</a>
      <a class="nav-link" href="#faq">FAQ</a>
      <a class="cta-btn" href="#contacto">Hablemos</a>
    </nav>
  </div>
</header>

<!-- ===================== INICIO — portada tipo deck (foto + panel) ===================== -->
<section class="hero" id="inicio">
  <div class="hero-photo">
